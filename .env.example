# Goal Reach AI Coach (Vercel serverless only — never expose in client)
GOAL_COACH_API_KEY=
# Optional alias
# GEMINI_API_KEY=
# GOAL_COACH_MODEL=gemini-2.0-flash
#
# Users can also bring their own key (BYOK) in the AI Coach dialog:
# Gemini, OpenAI, or Groq — stored in browser localStorage, sent only to /api/goal-coach.
#
# Local AI Coach testing:
#   npm run dev       # Vite serves UI + /api/goal-coach in-process (any free port)
# Optional: npm run dev:api + VITE_API_PROXY_TARGET=http://127.0.0.1:3001 to use Vercel dev instead